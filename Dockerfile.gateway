FROM python:3.13-slim@sha256:57b29a7c050c4e679e4bea572e14b3965cf4b5839de2da49d55e49ffc4024f39 AS uv-tools
RUN python -m pip install --no-cache-dir uv==0.13.5

# prisma-client-py 0.15.0 requires this engine protocol version.
FROM node:24.22.1-bookworm-slim@sha256:55fb5f5a527ea2c5c4a95f963e48ef90aa38c7b346054fdc8ee9957a2b55d205 AS prisma-cli
RUN npm install --omit=dev --prefix /prisma-cli prisma@5.17.0

# LiteLLM v1.106.2, resolved from its official stable release image.
FROM ghcr.io/berriai/litellm-database@sha256:35f2cec3a14bb297e08bfab56c1fc377432bc4071aaf71978fdff043a5d91e79
COPY --from=uv-tools /usr/local/bin/uv /usr/local/bin/uv
COPY pyproject.toml uv.lock /opt/subroute/runtime-lock/
COPY --from=prisma-cli /prisma-cli /opt/prisma/current
ENV PRISMA_CLI_PATH=/opt/prisma/current/node_modules/.bin/prisma
ENV PRISMA_BINARY_CACHE_DIR=/opt/prisma/current
# The release image supplies native runtime assets; the project lock is the
# authoritative Python dependency set for development, tests and deployment.
RUN UV_PROJECT_ENVIRONMENT=/app/.venv uv sync --locked --all-extras --no-dev --no-install-project --project /opt/subroute/runtime-lock --python /app/.venv/bin/python --no-cache
# A Prisma client generated by the release image belongs to its old engine.
# Regenerate from LiteLLM's own schema after applying the project lock.
RUN python -m prisma_cleanup && DATABASE_URL=postgresql://build:build@127.0.0.1/build python -m prisma generate --schema /app/schema.prisma

# Token counting must work even when tokenizer download hosts are unavailable.
ENV CUSTOM_TIKTOKEN_CACHE_DIR=/opt/subroute/tokenizer-cache
RUN python -c "import os,tiktoken; os.environ['TIKTOKEN_CACHE_DIR']=os.environ['CUSTOM_TIKTOKEN_CACHE_DIR']; [tiktoken.get_encoding(name) for name in ('cl100k_base','o200k_base')]"

COPY src /app/src
COPY config/litellm.yaml config/litellm.experts.yaml config/ui_sources.json /app/config/
