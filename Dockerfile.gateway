FROM python:3.13-slim@sha256:57b29a7c050c4e679e4bea572e14b3965cf4b5839de2da49d55e49ffc4024f39 AS python-base

FROM python-base AS uv-tools
RUN python -m pip install --no-cache-dir uv==0.13.5

# prisma-client-py 0.15.0 requires this engine protocol version.
FROM node:24.22.1-bookworm-slim@sha256:55fb5f5a527ea2c5c4a95f963e48ef90aa38c7b346054fdc8ee9957a2b55d205 AS prisma-cli
RUN npm install --omit=dev --prefix /prisma-cli prisma@5.17.0

FROM python-base AS gateway
WORKDIR /app
ENV PATH="/app/.venv/bin:$PATH" \
    PRISMA_CLI_PATH=/opt/prisma/current/node_modules/.bin/prisma \
    PRISMA_BINARY_CACHE_DIR=/opt/prisma/current \
    CUSTOM_TIKTOKEN_CACHE_DIR=/opt/subroute/tokenizer-cache
COPY --from=prisma-cli /usr/local/bin/node /usr/local/bin/node
COPY --from=prisma-cli /prisma-cli /opt/prisma/current
COPY pyproject.toml uv.lock /app/
RUN --mount=from=uv-tools,source=/usr/local/bin/uv,target=/usr/local/bin/uv \
    uv sync --locked --no-dev --no-install-project --no-cache

# Generate from the schema shipped by the locked LiteLLM proxy.
RUN python -c "from pathlib import Path; import litellm_proxy_extras as p; Path('/app/schema.prisma').write_bytes(Path(p.__file__).with_name('schema.prisma').read_bytes())" \
    && DATABASE_URL=postgresql://build:build@127.0.0.1/build python -m prisma generate --schema /app/schema.prisma

# Token counting must work even when tokenizer download hosts are unavailable.
RUN python -c "import os,tiktoken; os.environ['TIKTOKEN_CACHE_DIR']=os.environ['CUSTOM_TIKTOKEN_CACHE_DIR']; [tiktoken.get_encoding(name) for name in ('cl100k_base','o200k_base')]"

COPY src /app/src
COPY config/litellm.yaml /app/config/
ENTRYPOINT ["litellm"]
