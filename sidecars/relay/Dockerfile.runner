# Optional Relay worker. The coordinator remains the independent subroute-relay image.
# The optional Northstar mount is /opt/skills/northstar/SKILL.md; set northstar_path
# to that path in runner.json only when that file is mounted. It is not bundled.
FROM node:22.20.0-bookworm-slim@sha256:b21fe589dfbe5cc39365d0544b9be3f1f33f55f3c86c87a76ff65a02f8f5848e AS claude-cli
RUN npm install --global --prefix /opt/claude @anthropic-ai/claude-code@2.1.251 \
    && test -x /opt/claude/bin/claude \
    && test "$(wc -c < /opt/claude/lib/node_modules/@anthropic-ai/claude-code/bin/claude.exe)" -gt 4096

FROM subroute-relay:0.1.0
USER root
ENV HOME=/home/relay \
    PATH=/opt/claude/bin:${PATH}
WORKDIR /workspace
COPY --from=claude-cli /opt/claude /opt/claude
# The pinned Python base already includes Bash. Compose owns the writable mounts.
RUN command -v bash \
    && mkdir -p /home/relay /workspace \
    && chown -R 10001:10001 /home/relay /workspace
USER 10001:10001
CMD ["python", "-m", "subroute.relay.runner", "--config", "/config/runner.json"]
