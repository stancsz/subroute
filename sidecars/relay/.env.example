# Copy to .env.relay at repository root. Real credentials must not be committed.
RELAY_OPERATOR_KEY=replace-me
RELAY_NODE_KEYS={"workstation":"replace-with-a-different-machine-key"}
# Default: local pilot only. Set your actual interface IP and allowed hostname for LAN access.
RELAY_PUBLISH_IP=127.0.0.1
RELAY_PORT=8765
RELAY_ALLOWED_HOSTS=127.0.0.1:*,localhost:*,[::1]:*
# Optional dedicated Advisor; disabled without both a key and a positive daily limit.
RELAY_ADVISOR_URL=http://host.docker.internal:4040/v1
RELAY_ADVISOR_KEY=
RELAY_ADVISOR_DAILY_LIMIT=0
