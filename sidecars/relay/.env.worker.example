# Copy to a private .env.worker on this worker device and replace every placeholder.
# These example values are deliberately unusable and are not secrets.
RELAY_NODE_KEY=replace-with-the-distinct-node-key-configured-on-device-a
GATEWAY_MASTER_KEY=replace-with-a-key-accepted-by-the-port-4000-gateway

# Use absolute paths. On Windows, forward slashes are easiest for Docker Compose.
RELAY_WORKSPACE=D:/work/relay-project
RELAY_RUNNER_CONFIG=./runner.relay.json
